android_test {
    name: "ArkRecognitionTests",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    certificate: "platform",
    instrumentation_for: "ArkRecognition",
    static_libs: ["androidx.test.runner", "androidx.test.rules"],
    test_suites: ["device-tests"],
}
