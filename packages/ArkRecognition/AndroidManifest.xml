<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.arkui.recognition">
    <permission android:name="org.arkui.recognition.permission.CONTROL_RECOGNITION" android:protectionLevel="signature" />
    <uses-permission android:name="android.permission.CAPTURE_VISIBLE_CONTENT" />
    <uses-permission android:name="android.permission.SYSTEM_APPLICATION_OVERLAY" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application android:label="@string/app_name" android:icon="@drawable/ic_recognition"
        android:theme="@style/RecognitionSettingsTheme" android:allowBackup="false"
        android:supportsRtl="true" android:enableOnBackInvokedCallback="true">
        <provider android:name="androidx.core.content.FileProvider" android:authorities="org.arkui.recognition.images"
            android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/image_paths" />
        </provider>
        <activity android:name=".RecognitionActivity" android:exported="true" android:label="@string/recognize"
            android:theme="@style/RecognitionTheme" android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <service android:name=".RecognitionService" android:exported="true"
            android:permission="org.arkui.recognition.permission.CONTROL_RECOGNITION" />
        <activity android:name=".RecognitionSettingsActivity" android:exported="true" android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="org.arkui.recognition.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
