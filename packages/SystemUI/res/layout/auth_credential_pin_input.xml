<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/auth_credential_input"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingHorizontal="24dp"
    android:paddingBottom="@dimen/credential_pin_input_padding_bottom">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.android.keyguard.PasswordTextView
            android:id="@+id/credential_pin_dots"
            style="@style/Widget.TextView.Password"
            android:layout_width="match_parent"
            android:layout_height="@dimen/credential_pin_input_min_height"
            android:layout_gravity="center"
            android:background="@null"
            android:focusable="false"
            android:focusableInTouchMode="false"
            android:importantForAccessibility="noHideDescendants"
            app:scaledTextSize="@integer/scaled_password_text_size" />
        <ImeAwareEditText
            android:id="@+id/lockPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/credential_pin_input_min_height"
            android:background="@null"
            android:gravity="center"
            android:textColor="@android:color/transparent"
            android:textSize="32sp"
            android:singleLine="true"
            android:cursorVisible="false"
            android:longClickable="false"
            android:importantForAutofill="noExcludeDescendants"
            android:imeOptions="actionDone|flagNoFullscreen|flagNoPersonalizedLearning"
            android:inputType="numberPassword" />
    </FrameLayout>

    <TextView
        android:id="@+id/error"
        style="?errorTextAppearance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/credential_pin_error_margin_bottom"
        android:minHeight="24dp"
        android:gravity="center"
        android:accessibilityLiveRegion="polite" />

    <com.android.systemui.biometrics.ui.CredentialPinPadView
        android:id="@id/pin_pad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" />

</LinearLayout>
