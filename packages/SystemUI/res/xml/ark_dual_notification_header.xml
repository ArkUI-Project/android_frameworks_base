<ConstraintSet xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/ark_dual_notification_header_constraint">
    <Constraint android:id="@id/clock">
        <Layout android:layout_width="wrap_content"
            android:layout_height="@dimen/ark_dual_notification_clock_height"
            app:layout_constraintStart_toStartOf="@id/begin_guide"
            app:layout_constraintEnd_toEndOf="@id/end_guide"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="8dp" />
        <PropertySet android:visibility="visible" android:alpha="1" />
        <Transform android:scaleX="1" android:scaleY="1" />
    </Constraint>
    <Constraint android:id="@id/date">
        <Layout android:layout_width="0dp" android:layout_height="24sp"
            app:layout_constraintStart_toStartOf="@id/begin_guide"
            app:layout_constraintEnd_toEndOf="@id/end_guide"
            app:layout_constraintTop_toBottomOf="@id/clock" />
        <PropertySet android:visibility="visible" android:alpha="1" />
    </Constraint>
    <Constraint android:id="@id/carrier_group">
        <Layout android:layout_width="wrap_content" android:layout_height="32sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintStart_toEndOf="@id/clock"
            app:layout_constraintEnd_toEndOf="@id/end_guide"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintHorizontal_bias="1"
            android:layout_marginStart="12dp" />
        <PropertySet android:visibility="visible" android:alpha="1" />
    </Constraint>
    <Constraint android:id="@id/shade_header_system_icons">
        <Layout android:layout_width="wrap_content" android:layout_height="24sp"
            app:layout_constraintEnd_toEndOf="@id/end_guide"
            app:layout_constraintTop_toBottomOf="@id/carrier_group"
            android:layout_marginTop="4dp" />
        <PropertySet android:visibility="visible" android:alpha="1" />
    </Constraint>
    <Constraint android:id="@id/privacy_container">
        <Layout android:layout_width="wrap_content" android:layout_height="24sp"
            app:layout_constraintEnd_toEndOf="@id/end_guide"
            app:layout_constraintTop_toBottomOf="@id/carrier_group"
            android:layout_marginTop="4dp" />
    </Constraint>
</ConstraintSet>
