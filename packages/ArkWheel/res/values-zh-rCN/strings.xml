    <string name="radius">轮盘半径</string>
    <string name="icon_size">图标大小</string>
    <string name="count">显示快捷方式数量</string>
    <string name="arc">圆弧角度</string>
    <string name="animation">动画时长比例</string>
    <string name="animation_help" formatted="false">100% 使用默认动画时长，0% 关闭动画。同时遵循系统动画设置。</string>
    <string name="dim">背景压暗程度</string>
