<resources>
    <string name="app_name">快捷轮盘</string>
    <string name="intro">从屏幕底角向内斜上滑动，快捷方式沿圆弧展开。滑到图标上松手，或展开后点按图标即可使用。“更多”会打开悬浮的应用与功能面板。</string>
    <string name="preview">试用轮盘</string>
    <string name="preview_summary">体验当前布局与动画</string>
    <string name="items">轮盘快捷方式</string>
    <string name="items_summary">选择应用与功能，自由调整排列顺序</string>
    <string name="appearance">外观与动效</string>
    <string name="appearance_summary">圆弧、图标、莫奈取色与动画</string>
    <string name="invocation_title">角落手势</string>
    <string name="invocation_summary">屏幕底角与唤出范围</string>
    <string name="behavior">使用偏好</string>
    <string name="behavior_summary">小窗、触感反馈与排除应用</string>
    <string name="side">唤出底角</string>
    <string name="right">右下角</string>
    <string name="left">左下角</string>
    <string name="both">底部两角</string>
    <string name="corner_gesture_help">从右下角朝左上方斜滑，或从左下角朝右上方斜滑。继续滑到快捷方式上，松手即可打开；展开后也可点按图标。</string>
    <string name="corner_size">角落唤出范围</string>
    <string name="corner_size_help">范围越大，越容易从底角开始手势。角落区域用于斜向唤出；从该区域外上滑，可使用原有手势。</string>
    <string name="position">触发区域高度</string>
    <string name="position_help">0 为底部，数值越大，触发区域越靠上。轮盘始终从屏幕底角展开。</string>
    <string name="trigger_size">触发区域长度</string>
    <string name="trigger_opacity">触发条可见度</string>
    <string name="invocation">唤出手势</string>
