<resources>
    <string name="app_name">Quick wheel</string>
    <string name="intro">Swipe diagonally up and inward from a bottom corner to fan out your shortcuts. Slide onto an icon and release, or tap an icon after opening the wheel. More opens a floating app and action library.</string>
    <string name="preview">Try the wheel</string>
    <string name="preview_summary">Try your current layout and animation</string>
    <string name="items">Wheel shortcuts</string>
    <string name="items_summary">Choose apps and actions, then arrange their order</string>
    <string name="appearance">Appearance and motion</string>
    <string name="appearance_summary">Arc, icons, wallpaper colors, and animation</string>
    <string name="invocation_title">Corner gesture</string>
    <string name="invocation_summary">Bottom corners and activation area</string>
    <string name="behavior">Behavior</string>
    <string name="behavior_summary">Small windows, feedback, and excluded apps</string>
    <string name="side">Bottom corner</string>
    <string name="right">Bottom right</string>
    <string name="left">Bottom left</string>
    <string name="both">Both bottom corners</string>
    <string name="corner_gesture_help">Start at the bottom right and swipe toward the top left, or start at the bottom left and swipe toward the top right. Slide onto a shortcut and release to open it. You can also tap an icon after opening the wheel.</string>
    <string name="corner_size">Corner activation area</string>
    <string name="corner_size_help">A larger area makes the corner gesture easier to start. The corner area is reserved for diagonal activation. Start outside this area to use your usual upward gestures.</string>
    <string name="position">Trigger height</string>
    <string name="position_help">0 places the trigger at the bottom; higher values move it up. The wheel remains anchored to the bottom corner.</string>
    <string name="trigger_size">Trigger length</string>
    <string name="trigger_opacity">Trigger visibility</string>
