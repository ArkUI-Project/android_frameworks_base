    <string name="animation">Animation speed</string>
    <string name="animation_help" formatted="false">100% uses the default timing. 0% removes motion. System animation settings are also respected.</string>
    <string name="dim">Background dimming</string>
    <string name="monochrome">Wallpaper themed icons</string>
    <string name="monochrome_summary">Use Monet colors for apps with a monochrome icon. Other apps keep their original artwork.</string>
