// Copyright (C) 2026 The ArkUI Project; SPDX-License-Identifier: Apache-2.0
package {
    default_applicable_licenses: ["ArkWheel_license"],
}
license {
    name: "ArkWheel_license",
    visibility: [":__subpackages__"],
    license_kinds: ["SPDX-license-identifier-Apache-2.0"],
    license_text: ["NOTICE", "third_party/ocr/LICENSE.apache2", "third_party/ocr/NOTICE"],
}
java_library {
    name: "ArkWheelProtocol",
    srcs: ["protocol/**/*.java"],
}
android_app {
    name: "ArkWheel",
    defaults: ["platform_app_defaults"],
    srcs: ["src/**/*.java"],
    platform_apis: true,
    certificate: "platform",
    system_ext_specific: true,
    static_libs: [
        "ArkWheelProtocol",
        "ArkWheelOfflineOcr",
        "SettingsLibCollapsingToolbarBaseActivity",
        "SettingsLibSettingsTheme",
        "SettingsLibMainSwitchPreference",
        "SettingsLibAppPreference",
        "SettingsLibSliderPreference",
        "SettingsLibTopIntroPreference",
        "androidx.preference_preference",
        "androidx.recyclerview_recyclerview",
    ],
    jni_libs: ["libarkwheel_ocr_jpeg", "libarkwheel_ocr_png", "libarkwheel_ocr_leptonica", "libarkwheel_ocr_tesseract"],
    use_embedded_native_libs: false,
    aaptflags: ["-0", "traineddata"],
}
