<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.arkui.sidebar">
    <permission android:name="org.arkui.sidebar.permission.CONTROL_SIDEBAR"
        android:protectionLevel="signature" />
    <!-- Only the overlay and tactile feedback are owned by this application.
         No boot receiver, persistent process, cross-user, task-management,
         package enumeration or system-settings write permissions. SystemUI binds
         the foreground user's service and validates a narrow launcher protocol. -->
    <uses-permission android:name="android.permission.SYSTEM_APPLICATION_OVERLAY" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="org.arkui.game.permission.CONTROL_GAME" />
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>
    <application android:label="@string/app_name" android:icon="@drawable/ic_sidebar"
        android:theme="@style/SidebarTheme" android:allowBackup="false" android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true">
        <service android:name=".SidebarService" android:exported="true"
            android:permission="org.arkui.sidebar.permission.CONTROL_SIDEBAR" />
        <activity android:name=".SidebarSettingsActivity" android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="org.arkui.sidebar.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
