<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.arkui.game">
    <permission android:name="org.arkui.game.permission.CONTROL_GAME" android:protectionLevel="signature" />
    <uses-permission android:name="org.arkui.game.permission.CONTROL_GAME" />
    <uses-permission android:name="android.permission.SYSTEM_APPLICATION_OVERLAY" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <queries><intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent></queries>
    <application android:label="@string/app_name" android:icon="@drawable/ic_game"
        android:theme="@style/GameTheme" android:allowBackup="false" android:supportsRtl="true">
        <service android:name=".GameService" android:exported="true" android:permission="org.arkui.game.permission.CONTROL_GAME" />
        <activity android:name=".GameActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
            <intent-filter><action android:name="org.arkui.game.SETTINGS" /><category android:name="android.intent.category.DEFAULT" /></intent-filter>
        </activity>
    </application>
</manifest>
