    name: "ArkSystemBarFollowTests",
    srcs: ["src/**/*.java"],
    platform_apis: true,
    certificate: "platform",
    target_sdk_version: "28",
    static_libs: ["androidx.test.runner", "androidx.test.rules"],
    test_suites: ["device-tests"],
}
